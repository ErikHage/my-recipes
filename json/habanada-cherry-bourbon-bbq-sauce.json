  "steps": [
    {
      "id": 0,
      "text": "Add the habanadas, onion, garlic, and cherries to a saucepan with a small amount of oil."
    },
    {
      "id": 1,
      "text": "Sauté over medium heat for 5–7 minutes, until the onion softens."
    },
    {
      "id": 2,
      "text": "Add the tomato sauce, ⅓ cup apple cider vinegar, brown sugar, molasses, Worcestershire sauce, smoked paprika, black pepper, and salt."
    },
    {
      "id": 3,
      "text": "Bring to a gentle simmer."
    },
    {
      "id": 4,
      "text": "Cook uncovered for 25–30 minutes, stirring occasionally, until the peppers and cherries are very soft."
    },
    {
      "id": 5,
      "text": "Carefully blend the mixture with an immersion blender or regular blender until smooth."
    },
    {
      "id": 6,
      "text": "If you want a commercial-style sauce, strain it through a fine-mesh strainer. Return the blended sauce to the saucepan."
    },
    {
      "id": 7,
      "text": "Add ¼ cup bourbon to the sauce."
    },
    {
      "id": 8,
      "text": "Simmer uncovered for 5–10 minutes, stirring occasionally."
    },
    {
      "id": 9,
      "text": "Taste and adjust the sweetness, acidity, or salt as desired."
    },
    {
      "id": 10,
      "text": "Refrigerate sauce in airtight container for up to 1 week. Freeze in small portions for longer storage. Thaw in the refrigerator and reheat gently."
    }
  ],
