  "steps": [
    {
      "id": 0,
      "text": "Heat oven to 400°F."
    },
    {
      "id": 1,
      "text": "Lightly butter a ~2 quart casserole dish."
    },
    {
      "id": 2,
      "text": "Combine rhubarb, cornstarch, 3/4 cup sugar, and 1/2 tsp cinnamon in a large bowl. "
    },
    {
      "id": 3,
      "text": "Evenly spread mixture into the prepared casserole dish."
    },
    {
      "id": 4,
      "text": "Combine oats, flour, remaning 1/2 cup sugar, remaining 1/2 tsp cinnamon and salt in a large bowl. Cut in butter until crumbs form."
    },
    {
      "id": 5,
      "text": "Evenly scatter the crumb topping over the rhubarb filling. "
    },
    {
      "id": 6,
      "text": "Bake in the hot oven for around 35 minutes, or until golden and bubbly. "
    },
    {
      "id": 7,
      "text": "Allow to sit on the counter for 10 minutes before serving."
    },
    {
      "id": 8,
      "text": "Store leftover crisp covered on the counter for 1-2 days."
    }
  ],
