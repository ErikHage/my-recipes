  "steps": [
    {
      "id": 0,
      "text": "Position an oven rack 3 inches below the broiler and set the broiler to high."
    },
    {
      "id": 1,
      "text": "Toss the tomatillos, peppers, and onion with the oil in a large bowl."
    },
    {
      "id": 2,
      "text": "Transfer them to a half-sheet pan and broil until blistered and slightly charred, about 7 minutes. (Give the pan a shake every now and then to ensure even cooking.)"
    },
    {
      "id": 3,
      "text": "Let the charred vegetables cool slightly and then blend them on high with the cilantro and salt until smooth."
    },
    {
      "id": 4,
      "text": "Store tightly covered in the refrigerator for up to 2 weeks. Always serve at room temperature."
    }
  ],
