  "steps": [
    {
      "id": 0,
      "text": "Heat olive oil in a medium-large pot over medium heat. Add the recaíto and cook for 3–5 minutes, stirring occasionally."
    },
    {
      "id": 1,
      "text": "If using additional onion and garlic, add those too. You want everything fragrant, not browned."
    },
    {
      "id": 2,
      "text": "Add tomato sauce, sazón, oregano, cumin, bay leaf, and black pepper. Stir and cook for another 2 minutes."
    },
    {
      "id": 3,
      "text": "Add drained beans, diced potatoes, and broth."
    },
    {
      "id": 4,
      "text": "Bring to a gentle boil, then reduce heat to low."
    },
    {
      "id": 5,
      "text": "Cover partially and simmer for 20–25 minutes, stirring occasionally, until potatoes are tender."
    },
    {
      "id": 6,
      "text": "Mash a few beans against the side of the pot and stir them back in. This naturally thickens the sauce."
    },
    {
      "id": 7,
      "text": "Taste and adjust salt, pepper, and broth consistency. Remove the bay leaf."
    }
  ],
